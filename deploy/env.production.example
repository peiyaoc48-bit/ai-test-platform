# 复制到服务器项目目录下的 .env（不要提交）
PORT=3100

# —— 访问控制 ——
# 访问口令：登录后可编辑。请换成足够长的随机字符串，例如：openssl rand -base64 18
ACCESS_CODE=
# 公开演示：未登录访客可以只读浏览、运行示例用例（不能编辑，不能调用 AI 生成）
PUBLIC_DEMO=true
# 会话签名密钥：固定下来，重启后登录态不失效。例如：openssl rand -hex 32
SESSION_SECRET=
# 访客触发运行时的队列上限
PUBLIC_MAX_QUEUE=5

# —— 模型（可选，不填则自然语言步骤跳过）——
MIDSCENE_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_NAME=qwen3-vl-plus
MIDSCENE_MODEL_FAMILY=qwen3-vl
MIDSCENE_MODEL_TIMEOUT=120000
