# 复制为 .env 后填写（.env 已在 .gitignore 中，不会被提交）
# 未填写 API_KEY 时：自然语言步骤会被标记为“跳过（未配置模型）”，AI 生成用例不可用；普通 Playwright 步骤照常执行。

# —— Midscene 视觉模型（OpenAI 兼容接口）——
# 阿里云百炼：通用地址或工作空间专属地址均可
MIDSCENE_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_NAME=qwen3-vl-plus
MIDSCENE_MODEL_FAMILY=qwen3-vl
# 视觉模型响应较慢，默认 60 秒容易超时
MIDSCENE_MODEL_TIMEOUT=120000

# —— AI 生成用例使用的文本模型（可选，不填则复用上面的视觉模型）——
# GEN_MODEL_NAME=qwen-plus

# —— 平台自身 ——
# PORT=3100
# DATA_DIR=./data
# 浏览器：默认使用本机 Chrome（channel=chrome）；改为空字符串则使用 Playwright 自带 Chromium
# BROWSER_CHANNEL=chrome
# HEADLESS=true
# Midscene 缓存：重复运行同一用例时复用 AI 规划与元素定位，减少模型调用（默认开启；界面改版后可在用例上清除缓存）
# AI_CACHE=true
